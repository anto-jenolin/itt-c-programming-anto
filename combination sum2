class Solution:
    def combinationSum2(self, candidates: list[int], target: int) -> list[list[int]]:
        results = []
        # Sorting is essential to handle duplicates and prune branches
        candidates.sort()
        
        def backtrack(remain, combo, start):
            if remain == 0:
                results.append(list(combo))
                return
            
            for i in range(start, len(candidates)):
                # Pruning: If the current number is greater than the remainder,
                # no need to check further because the array is sorted.
                if candidates[i] > remain:
                    break
                
                # Skip duplicates: If this is not the first time we are picking 
                # a number for this position and it's the same as the previous one.
                if i > start and candidates[i] == candidates[i - 1]:
                    continue
                
                combo.append(candidates[i])
                # Move to i + 1 because each number can only be used once
                backtrack(remain - candidates[i], combo, i + 1)
                combo.pop()
                
        backtrack(target, [], 0)
        return results
