class Solution:
    def permuteUnique(self, nums: list[int]) -> list[list[int]]:
        res = []
        nums.sort()  # Sort to bring duplicates together
        
        def backtrack(path, used):
            if len(path) == len(nums):
                res.append(list(path))
                return
            
            for i in range(len(nums)):
                # If this index is already in our path, skip it
                if used[i]:
                    continue
                
                # Skip duplicate numbers: 
                # If the current number is the same as the previous one AND 
                # the previous one hasn't been used in this branch yet.
                if i > 0 and nums[i] == nums[i-1] and not used[i-1]:
                    continue
                
                # Choose
                used[i] = True
                path.append(nums[i])
                
                # Explore
                backtrack(path, used)
                
                # Un-choose (Backtrack)
                path.pop()
                used[i] = False
        
        backtrack([], [False] * len(nums))
        return res
