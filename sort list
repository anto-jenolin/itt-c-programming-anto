/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

// Helper function to split the list after 'step' elements.
// Returns the head of the remaining unsorted list.
struct ListNode* split(struct ListNode* head, int step) {
    if (!head) return NULL;
    
    // Move the pointer 'step' times ahead
    for (int i = 1; head->next && i < step; i++) {
        head = head->next;
    }
    
    // Disconnect the list segment and return the rest
    struct ListNode* rest = head->next;
    head->next = NULL;
    return rest;
}

// Helper function to merge two sorted lists.
// Returns a pair: the merged list head, and the merged list tail.
struct ListNode* merge(struct ListNode* l1, struct ListNode* l2, struct ListNode** tail) {
    struct ListNode dummy;
    struct ListNode* curr = &dummy;
    
    while (l1 && l2) {
        if (l1->val < l2->val) {
            curr->next = l1;
            l1 = l1->next;
        } else {
            curr->next = l2;
            l2 = l2->next;
        }
        curr = curr->next;
    }
    
    curr->next = l1 ? l1 : l2;
    
    // Traverse to the end of the merged list to find the new tail
    while (curr->next) {
        curr = curr->next;
    }
    
    *tail = curr;
    return dummy.next;
}

struct ListNode* sortList(struct ListNode* head) {
    if (!head || !head->next) return head;
    
    // 1. Count total number of elements in the list
    int length = 0;
    struct ListNode* curr = head;
    while (curr) {
        length++;
        curr = curr->next;
    }
    
    struct ListNode dummy;
    dummy.next = head;
    
    // 2. Bottom-up merge subarrays of size 1, 2, 4, 8...
    for (int step = 1; step < length; step *= 2) {
        struct ListNode* prev = &dummy;
        curr = dummy.next;
        
        while (curr) {
            struct ListNode* l1 = curr;
            struct ListNode* l2 = split(l1, step);
            curr = split(l2, step); // Next batch's start point
            
            struct ListNode* mergedTail = NULL;
            prev->next = merge(l1, l2, &mergedTail);
            prev = mergedTail;
        }
    }
    
    return dummy.next;
}
