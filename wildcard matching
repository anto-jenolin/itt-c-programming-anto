class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        s_ptr, p_ptr = 0, 0
        s_temp, p_star = -1, -1
        
        while s_ptr < len(s):
            # 1. Direct match or '?'
            if p_ptr < len(p) and (p[p_ptr] == s[s_ptr] or p[p_ptr] == '?'):
                s_ptr += 1
                p_ptr += 1
            
            # 2. Asterisk found: save the position and try matching 0 characters first
            elif p_ptr < len(p) and p[p_ptr] == '*':
                p_star = p_ptr
                s_temp = s_ptr
                p_ptr += 1
            
            # 3. No match, but a previous '*' was found: backtrack
            elif p_star != -1:
                # Increment s_temp to match one more character with '*'
                s_temp += 1
                s_ptr = s_temp
                p_ptr = p_star + 1
            
            # 4. No match and no '*' to backtrack to
            else:
                return False
        
        # 5. Check remaining pattern characters (must all be '*')
        while p_ptr < len(p) and p[p_ptr] == '*':
            p_ptr += 1
            
        return p_ptr == len(p)
