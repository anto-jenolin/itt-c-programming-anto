class Solution:
    
    def strStr(self, haystack: str, needle: str) -> int:
        n = len(haystack)
        m = len(needle)
        
        # If needle is longer than haystack, it can't exist inside it
        if m > n:
            return -1
        
        # Iterate through haystack, but only up to the point 
        # where the needle could still fit
        for i in range(n - m + 1):
            # Check if the substring starting at i matches the needle
            if haystack[i : i + m] == needle:
                return i
                
        return -1

        
