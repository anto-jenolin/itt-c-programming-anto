class Solution:
    def maxSubArray(self, nums: list[int]) -> int:
        # Initialize both current_sum and max_sum with the first element
        max_sum = current_sum = nums[0]
        
        for i in range(1, len(nums)):
            # If current_sum is negative, reset it to the current element
            # Otherwise, add the current element to current_sum
            current_sum = max(nums[i], current_sum + nums[i])
            
            # Update max_sum if the new current_sum is larger
            max_sum = max(max_sum, current_sum)
            
        return max_sum
