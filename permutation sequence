import math

class Solution:
    def getPermutation(self, n: int, k: int) -> str:
        # Create a list of numbers to pick from: [1, 2, ..., n]
        numbers = [str(i) for i in range(1, n + 1)]
        
        # Adjust k to be 0-indexed for easier math
        k -= 1
        
        res = []
        # Calculate permutations for each position
        for i in range(n - 1, -1, -1):
            # i! is the number of permutations for the remaining slots
            fact = math.factorial(i)
            
            # Index of the number we want from the available list
            index = k // fact
            res.append(numbers.pop(index))
            
            # Update k for the next position
            k %= fact
            
        return "".join(res)
