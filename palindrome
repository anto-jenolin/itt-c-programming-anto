class Solution:
    def isPalindrome(self, x: int) -> bool:
        # Edge cases: 
        # 1. Negative numbers are not palindromes.
        # 2. If the last digit is 0, the first must be 0 (only 0 itself works).
        if x < 0 or (x % 10 == 0 and x != 0):
            return False
        
        reversed_half = 0
        while x > reversed_half:
            # Extract last digit and add to reversed_half
            reversed_half = (reversed_half * 10) + (x % 10)
            # Remove last digit from x
            x //= 10
            
        # For even length: x == reversed_half (e.g., 1221 -> x=12, rev=12)
        # For odd length: x == reversed_half // 10 (e.g., 121 -> x=1, rev=12)
        return x == reversed_half or x == reversed_half // 10
