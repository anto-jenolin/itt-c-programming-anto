class Solution:
    def myAtoi(self, s: str) -> int:
        # Define constants for 32-bit limits
        INT_MIN, INT_MAX = -2**31, 2**31 - 1
        
        # 1. Whitespace: Remove leading spaces
        s = s.lstrip()
        if not s:
            return 0
        
        # 2. Signedness: Check for '+' or '-'
        sign = 1
        i = 0
        if s[0] == '-':
            sign = -1
            i += 1
        elif s[0] == '+':
            i += 1
            
        # 3. Conversion: Read digits until a non-digit character
        res = 0
        while i < len(s) and s[i].isdigit():
            res = res * 10 + int(s[i])
            i += 1
            
        # Apply sign
        res *= sign
        
        # 4. Rounding: Clamp to 32-bit range
        if res < INT_MIN:
            return INT_MIN
        if res > INT_MAX:
            return INT_MAX
            
        return res
