class Solution:
    
    def removeDuplicates(self, nums: List[int]) -> int:
        if not nums:
            return 0
        
        # k is the write pointer for the next unique element
        k = 1
        
        # Start scanning from the second element
        for i in range(1, len(nums)):
            # If the current element is different from the previous one
            if nums[i] != nums[i - 1]:
                # Update the position k with the new unique value
                nums[k] = nums[i]
                # Increment k to move to the next storage slot
                k += 1
                
        return k

        
