class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        memo = {}

        def dp(i: int, j: int) -> bool:
            # Check if result is already in memo
            if (i, j) in memo:
                return memo[(i, j)]
            
            # Base Case: If pattern is exhausted, string must be exhausted too
            if j == len(p):
                return i == len(s)
            
            # Check if current characters match
            first_match = i < len(s) and p[j] in {s[i], '.'}
            
            # Handling '*'
            if j + 1 < len(p) and p[j+1] == '*':
                # Choice 1: Skip '*' (0 occurrences)
                # Choice 2: Use '*' (if first_match is true, move string pointer i)
                res = dp(i, j + 2) or (first_match and dp(i + 1, j))
            else:
                # Normal character matching
                res = first_match and dp(i + 1, j + 1)
            
            memo[(i, j)] = res
            return res

        return dp(0, 0)
