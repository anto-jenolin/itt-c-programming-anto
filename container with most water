class Solution:
    def maxArea(self, height: list[int]) -> int:
        left = 0
        right = len(height) - 1
        max_water = 0
        
        while left < right:
            # Calculate width and the height of the shorter wall
            width = right - left
            h_left = height[left]
            h_right = height[right]
            
            # Current area is the limiting height * width
            current_area = min(h_left, h_right) * width
            
            # Update global maximum
            if current_area > max_water:
                max_water = current_area
            
            # Move the pointer of the shorter wall inward
            if h_left < h_right:
                left += 1
            else:
                right -= 1
                
        return max_water

        
