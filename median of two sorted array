class Solution:
    def findMedianSortedArrays(self, nums1: list[int], nums2: list[int]) -> float:
        # Ensure nums1 is the smaller array to optimize binary search
        if len(nums1) > len(nums2):
            nums1, nums2 = nums2, nums1
            
        m, n = len(nums1), len(nums2)
        low, high = 0, m
        total_half = (m + n + 1) // 2
        
        while low <= high:
            # Partition index for nums1
            partition1 = (low + high) // 2
            # Partition index for nums2 (calculated based on partition1)
            partition2 = total_half - partition1
            
            # Boundary values (handle out-of-bounds with infinity)
            maxLeft1 = nums1[partition1 - 1] if partition1 > 0 else float('-inf')
            minRight1 = nums1[partition1] if partition1 < m else float('inf')
            
            maxLeft2 = nums2[partition2 - 1] if partition2 > 0 else float('-inf')
            minRight2 = nums2[partition2] if partition2 < n else float('inf')
            
            # Check if we found the correct partition
            if maxLeft1 <= minRight2 and maxLeft2 <= minRight1:
                # Even total elements
                if (m + n) % 2 == 0:
                    return (max(maxLeft1, maxLeft2) + min(minRight1, minRight2)) / 2.0
                # Odd total elements
                else:
                    return float(max(maxLeft1, maxLeft2))
            
            # If we are too far right in nums1, move left
            elif maxLeft1 > minRight2:
                high = partition1 - 1
            # If we are too far left in nums1, move right
            else:
                low = partition1 + 1
        
        return 0.0
