class Solution:
    
    def divide(self, dividend: int, divisor: int) -> int:
        # Constants for 32-bit integer limits
        MAX_INT = 2147483647  # 2^31 - 1
        MIN_INT = -2147483648 # -2^31
        
        # Handle overflow case
        if dividend == MIN_INT and divisor == -1:
            return MAX_INT
        
        # Determine the sign of the result
        negative = (dividend < 0) != (divisor < 0)
        
        # Work with absolute values
        a, b = abs(dividend), abs(divisor)
        quotient = 0
        
        # Exponential search / Bit manipulation logic
        while a >= b:
            temp_divisor, multiple = b, 1
            # Double the divisor and the multiple as long as it fits
            while a >= (temp_divisor << 1):
                temp_divisor <<= 1
                multiple <<= 1
            
            # Subtract the largest found multiple and update quotient
            a -= temp_divisor
            quotient += multiple
            
        return -quotient if negative else quotient

        
