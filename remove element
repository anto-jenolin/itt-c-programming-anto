class Solution:
    
    def removeElement(self, nums: List[int], val: int) -> int:
        # k serves as the index for the next non-val element
        k = 0
        
        for i in range(len(nums)):
            if nums[i] != val:
                # Move the valid element to the 'k' position
                nums[k] = nums[i]
                # Increment k to track the count of valid elements
                k += 1
                
        return k

        
