class Solution:
    def totalNQueens(self, n: int) -> int:
        # Sets to track occupied columns and diagonals
        cols = set()
        pos_diag = set() # (r + c)
        neg_diag = set() # (r - c)
        
        def backtrack(r):
            # Base case: If we reached the end, we found 1 valid solution
            if r == n:
                return 1
            
            count = 0
            for c in range(n):
                # Check if the current square is under attack
                if c in cols or (r + c) in pos_diag or (r - c) in neg_diag:
                    continue
                
                # Place the queen (add to sets)
                cols.add(c)
                pos_diag.add(r + c)
                neg_diag.add(r - c)
                
                # Move to the next row and add found solutions to count
                count += backtrack(r + 1)
                
                # Backtrack (remove from sets)
                cols.remove(c)
                pos_diag.remove(r + c)
                neg_diag.remove(r - c)
                
            return count
            
        return backtrack(0)
