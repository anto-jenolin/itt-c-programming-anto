#include <stdlib.h>
#include <limits.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

int maximumGap(int* nums, int numsSize) {
    if (numsSize < 2) {
        return 0;
    }

    // 1. Find global minimum and maximum values
    int min_val = nums[0];
    int max_val = nums[0];
    for (int i = 1; i < numsSize; i++) {
        if (nums[i] < min_val) min_val = nums[i];
        if (nums[i] > max_val) max_val = nums[i];
    }

    // If all elements are identical, the maximum gap is 0
    if (min_val == max_val) {
        return 0;
    }

    // 2. Calculate optimal bucket size and total count
    int bucket_size = MAX(1, (max_val - min_val) / (numsSize - 1));
    int bucket_count = (max_val - min_val) / bucket_size + 1;

    // Allocate tracking arrays
    int* has_element = (int*)calloc(bucket_count, sizeof(int));
    int* bucket_min = (int*)malloc(bucket_count * sizeof(int));
    int* bucket_max = (int*)malloc(bucket_count * sizeof(int));

    for (int i = 0; i < bucket_count; i++) {
        bucket_min[i] = INT_MAX;
        bucket_max[i] = INT_MIN;
    }

    // 3. Distribute elements across the buckets
    for (int i = 0; i < numsSize; i++) {
        int num = nums[i];
        int bucket_idx = (num - min_val) / bucket_size;
        
        has_element[bucket_idx] = 1;
        bucket_min[bucket_idx] = MIN(bucket_min[bucket_idx], num);
        bucket_max[bucket_idx] = MAX(bucket_max[bucket_idx], num);
    }

    // 4. Scan consecutive non-empty buckets to find the max gap
    int max_gap = 0;
    int previous_max = min_val;

    for (int i = 0; i < bucket_count; i++) {
        // Ignore empty buckets
        if (!has_element[i]) {
            continue;
        }

        // Gap is measured from current bucket min to previous bucket max
        int gap = bucket_min[i] - previous_max;
        if (gap > max_gap) {
            max_gap = gap;
        }
        previous_max = bucket_max[i];
    }

    // Clean up allocated heap memory
    free(has_element);
    free(bucket_min);
    free(bucket_max);

    return max_gap;
}
