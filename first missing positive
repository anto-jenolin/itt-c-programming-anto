class Solution:
    def firstMissingPositive(self, nums: list[int]) -> int:
        n = len(nums)
        
        # Step 1: Cyclic Sort (In-place)
        # Try to put every number x at index x - 1 if x is in range [1, n]
        for i in range(n):
            # While the current number is in the valid range and not at its correct spot
            # nums[i] should be at index nums[i] - 1
            while 1 <= nums[i] <= n and nums[nums[i] - 1] != nums[i]:
                # Swap nums[i] with the element at its target index
                target_idx = nums[i] - 1
                nums[i], nums[target_idx] = nums[target_idx], nums[i]
        
        # Step 2: Identify the first index that doesn't match its value
        for i in range(n):
            if nums[i] != i + 1:
                return i + 1
        
        # Step 3: If all spots 1 to n are filled, the missing one is n + 1
        return n + 1
