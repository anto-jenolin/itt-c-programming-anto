class Solution:
    def countAndSay(self, n: int) -> str:
        # Base case
        res = "1"
        
        # Generate terms from 2 to n
        for _ in range(n - 1):
            next_term = ""
            i = 0
            
            while i < len(res):
                count = 1
                # Count consecutive identical characters
                while i + 1 < len(res) and res[i] == res[i + 1]:
                    count += 1
                    i += 1
                
                # Append: count + the digit itself
                next_term += str(count) + res[i]
                i += 1
                
            res = next_term
            
        return res
