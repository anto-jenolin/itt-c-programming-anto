int majorityElement(int* nums, int numsSize) {
    int candidate = 0;
    int count = 0;
    
    for (int i = 0; i < numsSize; i++) {
        // If count reaches 0, we choose a new candidate
        if (count == 0) {
            candidate = nums[i];
        }
        
        // If current element matches candidate, increment; else decrement
        if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }
    
    return candidate;
}
