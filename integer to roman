class Solution:
    def intToRoman(self, num: int) -> str:
        # Define all Roman numeral symbols and their values
        # Including the "subtractive" cases as unique symbols
        roman_map = [
            (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
            (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
            (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")
        ]
        
        res = []
        
        for value, symbol in roman_map:
            # If the number is 0, we are done
            if num == 0: break
            
            # Determine how many times this symbol fits into the number
            count = num // value
            if count > 0:
                res.append(symbol * count)
                # Subtract the total value represented by these symbols
                num -= (value * count)
                
        return "".join(res)

        
